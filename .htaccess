# Make browsers revalidate the site files on every visit instead of serving a
# stale copy. Apache still answers 304 Not Modified (via ETag) when nothing
# changed, so this costs almost nothing.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
